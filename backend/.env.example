# Copy this file to .env and fill in your own values.

# OpenRouter API key, used for the Qwen-2-VL report (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Public base URL of this backend, used to build image links.
# Use http://localhost:5000 for local development, or your ngrok URL.
PUBLIC_BACKEND_URL=http://localhost:5000

# Filename of your Firebase service account key, placed in backend/
FIREBASE_KEY_PATH=firebase-service-account.json
